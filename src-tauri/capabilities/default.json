{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "VibeSorter desktop capabilities",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/vibesorter-sidecar",
          "sidecar": true,
          "args": [
            "browser",
            "--db",
            {
              "validator": ".+"
            },
            "--host",
            "127.0.0.1",
            "--port",
            {
              "validator": "[0-9]{1,5}"
            }
          ]
        },
        {
          "name": "binaries/vibesorter-sidecar",
          "sidecar": true,
          "args": [
            "index",
            {
              "validator": ".+"
            },
            "--json",
            "--progress"
          ]
        }
      ]
    }
  ]
}
